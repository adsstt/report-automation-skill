{
  "name": "report-automation-skill",
  "version": "1.0.0",
  "description": "Reusable report automation skill with a DeepSeek Harness installer adapter",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "requirements.txt",
    "evals/evals.json",
    "evals/fixtures",
    "evals/fresh-product/README.md",
    "evals/fresh-product/expected",
    "evals/fresh-product/make_fixtures.py",
    "evals/fresh-product/profile.confirmed.yaml",
    "evals/fresh-product/run_acceptance.py",
    "evals/fresh-product/samples",
    "evals/fresh-product/sources",
    "examples",
    "references",
    "scripts/*.py",
    "tests/*.py",
    "tests/*.mjs"
  ],
  "scripts": {
    "test:dsh": "node --test tests/dsh-package.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "report-automation"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adsstt/report-automation-skill.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
